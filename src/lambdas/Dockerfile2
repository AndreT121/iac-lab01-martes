FROM amazoncorretto:11-alpine-jdk
RUN mkdir -p /opt
COPY com /opt/com
WORKDIR /opt

# Descarga la dependencia y compila
RUN wget https://repo1.maven.org/maven2/com/amazonaws/aws-lambda-java-core/1.2.3/aws-lambda-java-core-1.2.3.jar -O /opt/aws-lambda-java-core.jar
RUN javac -cp /opt/aws-lambda-java-core.jar com/example/lambda/Handler2.java
RUN jar cvf lambda2.jar com/example/lambda/Handler2.class

FROM amazon/aws-lambda-java:11
COPY --from=0 /opt/lambda2.jar ${LAMBDA_TASK_ROOT}/lib/
CMD ["com.example.lambda.Handler2::handleRequest"]